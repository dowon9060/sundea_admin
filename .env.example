# 순대차 Cloudflare Workers API
SUNDAE_API_URL=http://127.0.0.1:8787

# Worker X-Admin-Key (backend-cf ADMIN_KEY 와 동일)
SUNDAE_ADMIN_KEY=replace-with-backend-ADMIN_KEY

# 세션 서명용 시크릿
SUNDAE_SESSION_SECRET=replace-with-long-random-secret

# 네이버 클라우드 Maps Client ID (앱 EXPO_PUBLIC_NCP_KEY_ID 와 동일)
# NCP 콘솔 Web 서비스 URL에 http://localhost:3000 등 등록 필요
NEXT_PUBLIC_NCP_KEY_ID=
